{
  "name": "@jgalego/teamapi-backstage",
  "version": "0.2.0",
  "description": "Backstage catalog entity provider that reads a live Team API as Code REST API",
  "keywords": [
    "teamapi",
    "team-api-as-code",
    "team-topologies",
    "backstage",
    "backstage-plugin",
    "entity-provider",
    "catalog",
    "service-catalog"
  ],
  "license": "MIT",
  "homepage": "https://github.com/JGalego/TeamAPI#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/JGalego/TeamAPI.git",
    "directory": "packages/backstage-plugin"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src --max-warnings 0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
