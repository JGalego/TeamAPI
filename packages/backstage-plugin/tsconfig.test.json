{
  // Typechecks the test sources and this package's vitest config, both of which tsconfig.json
  // deliberately excludes so they stay out of the published build. Without this project they
  // would never be typechecked at all. `rootDir` widens to the workspace root because
  // vitest.config.ts imports the shared config from there; nothing is emitted, so that is free.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": "../.."
  },
  "include": ["src", "vitest.config.ts", "../../vitest.shared.ts"],
  "exclude": []
}
