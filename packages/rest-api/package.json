{
  "name": "@jgalego/teamapi-rest-api",
  "version": "0.7.0",
  "description": "Read-only REST API over a resolved Team API org graph",
  "keywords": [
    "teamapi",
    "team-api-as-code",
    "team-topologies",
    "fastify",
    "rest-api",
    "openapi",
    "swagger",
    "dashboard",
    "prometheus",
    "etag",
    "pagination"
  ],
  "license": "MIT",
  "homepage": "https://github.com/JGalego/TeamAPI#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/JGalego/TeamAPI.git",
    "directory": "packages/rest-api"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && mkdir -p dist/dashboard && cp src/dashboard/index.html dist/dashboard/index.html",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@jgalego/teamapi-core": "workspace:*",
    "@jgalego/teamapi-schema": "workspace:*",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
