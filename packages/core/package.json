{
  "name": "@jgalego/teamapi-core",
  "version": "0.10.0",
  "description": "Team API as Code resolution, graph building, cognitive load, context mapping, and diagram generation",
  "keywords": [
    "teamapi",
    "team-api-as-code",
    "team-topologies",
    "org-graph",
    "cognitive-load",
    "ddd",
    "context-map",
    "mermaid",
    "graphviz",
    "gaps",
    "platform-engineering"
  ],
  "license": "MIT",
  "homepage": "https://github.com/JGalego/TeamAPI#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/JGalego/TeamAPI.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@jgalego/teamapi-schema": "workspace:*",
    "js-yaml": "^4.1.0",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
