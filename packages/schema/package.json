{
  "name": "@jgalego/teamapi-schema",
  "version": "0.6.0",
  "description": "Zod schemas and types for the extended Team API as Code specification",
  "keywords": [
    "teamapi",
    "team-api-as-code",
    "team-topologies",
    "zod",
    "json-schema",
    "yaml",
    "validation",
    "types"
  ],
  "license": "MIT",
  "homepage": "https://github.com/JGalego/TeamAPI#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/JGalego/TeamAPI.git",
    "directory": "packages/schema"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
