{
  "name": "team-topologies-toolchain",
  "private": true,
  "version": "0.1.0",
  "description": "Team Topologies + DDD Team API as Code toolchain: schema, organigrams, REST API, MCP server",
  "license": "MIT",
  "homepage": "https://github.com/JGalego/TeamAPI#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/JGalego/TeamAPI.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks && git config blame.ignoreRevsFile .git-blame-ignore-revs || true",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm deadcode && pnpm build && pnpm fmt:check && pnpm test:coverage",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint && eslint eslint.config.mjs --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "deadcode": "knip",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fmt:check": "pnpm teamapi fmt examples --check",
    "teamapi": "node packages/cli/dist/main.js",
    "example:validate": "pnpm teamapi validate examples/acme-org",
    "example:render": "pnpm teamapi render examples/acme-org --scope topology",
    "example:serve-api": "pnpm teamapi serve-api examples/acme-org --port 3000",
    "example:serve-mcp": "pnpm teamapi serve-mcp examples/acme-org",
    "bench:resolve": "node scripts/bench-resolve.mjs",
    "docs:build": "node scripts/build-docs.mjs --out site-out/latest --label latest",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "highlight.js": "^11.12.0",
    "knip": "^6.29.0",
    "marked": "^18.0.9",
    "prettier": "^3.9.6",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.32.1"
}
